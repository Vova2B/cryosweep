# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# The junit file the verification block is computed from. Untracked-but-not-ignored, it made
# every block report a dirty working tree, including the ones CI printed for a fresh clone.
pytest-results.xml

# CLI default output (written wherever the CLI is run from)
cryosweep_out.*

# Local-only measurement data: never commit real .dat files or the map that names them.
# The suite resolves them through this map and skips cleanly when it is absent.
real_data_map.json
*.dat
!tests/core/fixtures/*.dat
!examples/*.dat

# OS
.DS_Store

# Internal design/planning docs live in the private development tree, not here.
docs/superpowers/
